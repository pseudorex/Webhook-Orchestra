{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "DLQ Current Backlog Size",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "max(webhook_dlq_size)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "super-light-yellow", "value": 1 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      }
    },
    {
      "title": "High Priority Queue Backlog",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "max(webhook_queue_length{queue_name=\"high_priority\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      }
    },
    {
      "title": "Default Queue Backlog",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "max(webhook_queue_length{queue_name=\"default\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "title": "Low Priority Queue Backlog",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "max(webhook_queue_length{queue_name=\"low_priority\"})",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "title": "Endpoint Health Scores",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "max(webhook_endpoint_health_score{tenant_id=~\"$tenant_id\"}) by (endpoint_url, tenant_id)",
          "legendFormat": "{{endpoint_url}} (Tenant {{tenant_id}})",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Failures - DLQ Moves (Last 5m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum(increase(webhook_dlq_moves_total{tenant_id=~\"$tenant_id\"}[5m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Failures - DLQ Failure Types",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 5 },
      "targets": [
        {
          "expr": "sum(webhook_dlq_moves_total{tenant_id=~\"$tenant_id\"}) by (failure_type)",
          "legendFormat": "{{failure_type}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayLabels": ["value", "percent"],
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "pieType": "donut"
      }
    },
    {
      "title": "Throughput - Delivery Attempts per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "targets": [
        {
          "expr": "sum(rate(webhook_delivery_attempts_total{tenant_id=~\"$tenant_id\"}[1m])) by (status_code)",
          "legendFormat": "Status {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "none",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          }
        }
      }
    },
    {
      "title": "Throughput - Latency Percentiles (Seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(webhook_delivery_latencies_seconds_bucket{tenant_id=~\"$tenant_id\"}[1m])) by (le, tenant_id))",
          "legendFormat": "Tenant {{tenant_id}} (p50)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(webhook_delivery_latencies_seconds_bucket{tenant_id=~\"$tenant_id\"}[1m])) by (le, tenant_id))",
          "legendFormat": "Tenant {{tenant_id}} (p95)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(webhook_delivery_latencies_seconds_bucket{tenant_id=~\"$tenant_id\"}[1m])) by (le, tenant_id))",
          "legendFormat": "Tenant {{tenant_id}} (p99)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "none"
          }
        }
      }
    },
    {
      "title": "Retries - Attempts Scheduled / min",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "sum(rate(webhook_retries_total{tenant_id=~\"$tenant_id\"}[1m])) by (tenant_id, retry_count)",
          "legendFormat": "Tenant {{tenant_id}} (Retry {{retry_count}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "none"
          }
        }
      }
    },
    {
      "title": "Workers - Celery Task Process Duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(worker_task_duration_seconds_bucket[1m])) by (le, task_name))",
          "legendFormat": "{{task_name}} (p95)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "none"
          }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["webhook-orchestra"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-datasource"
        },
        "definition": "label_values(webhook_delivery_attempts_total, tenant_id)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "tenant_id",
        "allValue": ".*",
        "options": [],
        "query": {
          "query": "label_values(webhook_delivery_attempts_total, tenant_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Webhook Orchestra Performance Monitor",
  "uid": "webhook-orchestra-core",
  "version": 3
}